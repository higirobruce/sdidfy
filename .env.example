# SDID Auth Bridge — broker configuration
# Copy to .env for local development. Never commit real secrets.

NODE_ENV=development
BROKER_PORT=3100
BROKER_ISSUER=http://localhost:3100

DATABASE_URL=postgresql://sdid:sdid_dev@localhost:5432/sdid_bridge
REDIS_URL=redis://localhost:6379

# SDID adapter strategy: mock | oidc | proprietary  (02 §4 — feature-flagged cutover)
SDID_STRATEGY=mock

# Pepper for pseudonymised NID (keyed hash, Q8). In production this key lives in
# the GoR-approved KMS/HSM (decision #5) — env var is a dev-only stand-in.
NID_PEPPER=dev-only-nid-pepper-change-me

# Dev key store location for broker signing keys (prod: KMS/HSM, decision #5).
KEYSTORE_DIR=./data/keys

# Attestation verification: mock verifier accepts device-sim attestations.
# Production uses Play Integrity / App Attest verifiers (05 §4).
ATTESTATION_MODE=mock

# Admin API bearer token for RP onboarding (dev only; prod is MFA'd admin IdP, T12).
ADMIN_API_TOKEN=dev-admin-token
