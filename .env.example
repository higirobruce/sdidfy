# SDID Auth Bridge — broker configuration
# Copy to .env for local development. Never commit real secrets.

NODE_ENV=development
BROKER_PORT=3100
BROKER_ISSUER=http://localhost:3100

DATABASE_URL=postgresql://sdid:sdid_dev@localhost:5432/sdid_bridge
REDIS_URL=redis://localhost:6379

# SDID adapter strategy: mock | oidc | proprietary  (02 §4 — feature-flagged cutover)
SDID_STRATEGY=mock

# Pepper for pseudonymised NID (keyed hash, Q8). In production this key lives in
# the GoR-approved KMS/HSM (decision #5) — env var is a dev-only stand-in.
NID_PEPPER=dev-only-nid-pepper-change-me

# Dev key store location for broker signing keys (prod: KMS/HSM, decision #5).
KEYSTORE_DIR=./data/keys

# Attestation verification: mock verifier accepts device-sim attestations.
# Production uses Play Integrity / App Attest verifiers (05 §4).
ATTESTATION_MODE=mock

# --- Strict-mode attestation (only consulted when ATTESTATION_MODE=strict) ---
# TTL of a server-issued attestation nonce (03 §2 step 1, T4). Must be <= the
# verifiers' maximum accepted token age (300 s) — a longer-lived nonce would
# widen the very replay window it exists to close.
ATTESTATION_NONCE_TTL_SECONDS=300

# Android app identity. An attestation that does not name THIS package signed
# by ONE of these certificates is `app_mismatch` — empty is a configuration
# error in strict mode, never "accept any".
ANDROID_PACKAGE_NAME=
ANDROID_CERT_SHA256_DIGESTS=

# Play Integrity service-account credentials (path or inline JSON) for
# playintegrity.googleapis.com decodeIntegrityToken. NOT YET AVAILABLE: the
# decoder in apps/broker/src/trust/play-integrity.decoder.ts is an unimplemented
# seam that throws, so Android strict mode fails closed (503) until it lands.
PLAY_INTEGRITY_CREDENTIALS_JSON=

# Apple App Attest: App ID is <teamId>.<bundleId>. Production MUST set
# IOS_ATTESTATION_PRODUCTION=true, or a dev-provisioned build attests
# successfully against production.
IOS_APP_ID=
IOS_ATTESTATION_PRODUCTION=false

# Admin API bearer token for RP onboarding (dev only; prod is MFA'd admin IdP, T12).
ADMIN_API_TOKEN=dev-admin-token

# Re-verification cadence in seconds (03 §6, decision #9). A device binding
# older than this since its last SDID contact is re-asserted at its next use;
# this is our only revoked/deceased-identity signal. Default 90 days.
REVERIFY_INTERVAL_SECONDS=7776000

# =========================================================================
# Phase 3 — observability, anomaly detection, push.
# apps/broker/src/config.ts is authoritative; docs/runbook.md §11–§14
# explains the operations behind each of these.
# =========================================================================

# ---------------------------------------------------------------- metrics
# Serve GET /metrics (Prometheus text exposition, admin/metrics-token gated).
# `false` makes the route answer 404 — it is never served unprotected.
METRICS_ENABLED=true

# Bearer token for /metrics. Empty falls back to ADMIN_API_TOKEN, which
# PRODUCTION REFUSES: a scrape job's credential lives in widely-readable
# monitoring config and must not also be able to onboard a relying party (T12).
METRICS_TOKEN=

# --------------------------------------------------------------- logging
# JSON structured logs: debug | info | warn | error | silent.
# Every line is redacted (deny-listed field names + a 16-digit NID scrubber),
# so a biometric byte, raw NID, token or nonce cannot be logged by construction.
LOG_LEVEL=info

# ----------------------------------------------- anomaly detection (06 §5)
# DETECTION ONLY. Crossing a threshold writes an audit row, a metric and a log
# line — it never bans, blocks, suspends or revokes. A false positive on a
# national identity service would lock citizens out of a public service; rate
# limits and lockouts remain the automated controls.
ANOMALY_ENABLED=true

# HMAC key for the truncated source handle recorded on a detection. A separate
# key from NID_PEPPER on purpose. Production refuses the dev value.
ANOMALY_SOURCE_PEPPER=dev-only-anomaly-source-pepper-change-me

# T14 — enrolment probing: distinct pseudo-NIDs attempted from one source IP.
ANOMALY_ENROL_PROBE_DISTINCT_NIDS=10
ANOMALY_ENROL_PROBE_WINDOW_SECONDS=900

# T2/T3 — attestation rejections from one source IP.
ANOMALY_ATTESTATION_REJECTION_THRESHOLD=10
ANOMALY_ATTESTATION_REJECTION_WINDOW_SECONDS=900

# T9 — CIBA initiations from one RP. 200/5 min sits below the hard 60/min rate
# limit (300/5 min) so it fires as a LEADING indicator, not after throttling.
ANOMALY_CIBA_INITIATION_THRESHOLD=200
ANOMALY_CIBA_INITIATION_WINDOW_SECONDS=300

# T1/T4 — signature failures against one device binding (matches the lockout).
ANOMALY_SIGNATURE_FAILURE_THRESHOLD=5
ANOMALY_SIGNATURE_FAILURE_WINDOW_SECONDS=900

# T7 — citizen-flagged ("I didn't request this") denials against one RP.
# Deliberately low: a citizen reporting an unexpected prompt is the highest-
# signal input the system has.
ANOMALY_SUSPICIOUS_DENIAL_THRESHOLD=3
ANOMALY_SUSPICIOUS_DENIAL_WINDOW_SECONDS=3600

# ------------------------------------------------------ wake-only push (05 §5)
# The payload carries a type and a version and NOTHING else: no auth data, no
# RP name, no binding message, no citizen identifier. The app pulls the real
# request over the authenticated backchannel.
#
# NOT YET DEPLOYABLE: no GoR Firebase project and no GoR Apple team exist, so
# both transports are declared seams that throw descriptively. Push is an
# optimisation over the app's own polling, so an unconfigured transport is
# logged and metered, never fatal. Production refuses HALF-configured values.
PUSH_TIMEOUT_MS=5000

# FCM (Android) — service-account key with the Firebase Cloud Messaging API
# enabled, as a filesystem path or inline JSON.
FCM_PROJECT_ID=
FCM_CREDENTIALS_JSON=

# APNs (iOS) — token auth: team id, key id, the .p8 auth key (path or inline
# PEM), and the app bundle id as the topic. Production MUST set
# APNS_PRODUCTION=true or every send goes to the sandbox and reaches nothing.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY_P8=
APNS_TOPIC=
APNS_PRODUCTION=false

# `alert` sends a content-free loc-key the app localises (rw/en/fr) and is
# delivered promptly; `background` is fully silent but iOS throttles it, which
# can exceed the 180 s CIBA window.
APNS_PUSH_TYPE=alert
